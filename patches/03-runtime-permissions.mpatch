# =============================================================================
# 03-runtime-permissions.mpatch  -  ask for storage/phone permission at run time
# -----------------------------------------------------------------------------
# Why: patch 06 raises targetSdkVersion to 24 (Android 15/16 refuse to install
#      anything lower). From target 23 on, Android no longer grants "dangerous"
#      permissions at install time; the app must ask. MortPlayer never asks, so
#      without this it could not see your audiobook folders.
# Fix: two hooks in MainPlayer, both calling our new PermissionHelper class:
#        * at the end of onResume()  -> ask for READ/WRITE_EXTERNAL_STORAGE and
#                                       READ_PHONE_STATE if missing (once per run)
#        * new method onRequestPermissionsResult() -> on "Allow", rescan the
#                                       audiobook folders; on "Deny", show a hint
#      (Activity's own onRequestPermissionsResult is empty, so adding it is safe.)
# Note: applies on top of patch 01 (same file), so its checksum is the
#       checksum AFTER patch 01.
# =============================================================================
project: app

file: smali/de/stohelit/audiobookplayer/MainPlayer.smali
sha256: 408ccf661bd1ee0cc4fb363916684c647d367c049101d95cce7ef19fc745a285
insert-after 8960
+    # MortPerm: runtime permissions (community build)
+    invoke-static {p0}, Lde/stohelit/audiobookplayer/PermissionHelper;->onResume(Landroid/app/Activity;)V
+
insert-after 13237
+
+# MortPerm: added method (community build); Activity's default implementation is empty
+.method public onRequestPermissionsResult(I[Ljava/lang/String;[I)V
+    .locals 0
+
+    invoke-static {p0, p1, p2, p3}, Lde/stohelit/audiobookplayer/PermissionHelper;->onRequestPermissionsResult(Landroid/app/Activity;I[Ljava/lang/String;[I)V
+
+    return-void
+.end method
