# =============================================================================
# 01-errorreport-crash.mpatch  -  "MortPlayer closes right after starting"
# -----------------------------------------------------------------------------
# Credit: this fix is by crazyfury on XDA (MortPlayer thread, page 24, 2020).
#
# Problem: MainPlayer.errorReport() asks Java for the default crash handler and
#          blindly casts it to MortPlayer's own ReportExceptionHandler. On newer
#          Android, WebView/Chromium replaces that handler with its own
#          (org.chromium.base.JavaExceptionReporter), so the cast throws
#          ClassCastException and the app dies at start-up.
# Fix:     check "instanceof" first; if it is someone else's handler, just log
#          it and skip the "send error report?" dialog instead of crashing.
#
# Content note: the dialog-building lines below look like the original ones
#          because crazyfury's version uses different register numbers (v2->v4,
#          v3->v5), so every line that touches those registers had to change.
#          Only the NEW lines are stored here; the removed lines are not.
# =============================================================================
project: app

file: smali/de/stohelit/audiobookplayer/MainPlayer.smali
sha256: 216c760d876c71d6a37a5c510edf18ff291a335c58c4d6686ff8e862cadffe22
replace 3831
+    # community patch 01 (fix by crazyfury, XDA): only treat the default crash handler as
+    # ReportExceptionHandler when it really is one; WebView/Chromium installs its own handler
+    # and the old unchecked cast crashed the app on start. Registers renamed, logic as in his post.
+    .locals 6
+    .annotation build Landroid/annotation/SuppressLint;
+        value = {
+            "ResourceType"
+        }
+    .end annotation
